# Copiar a .env antes de levantar con Docker. Valores ficticios.
DB_HOST=teleandes_db
DB_PORT=3306
DB_NAME=teleandes
DB_USER=teleandes_user
DB_PASSWORD=cambiar_esta_clave
DB_CONNECT_TIMEOUT=5

# Solo los usa el contenedor de MySQL en el primer arranque
MYSQL_ROOT_PASSWORD=cambiar_clave_root
MYSQL_DATABASE=teleandes
MYSQL_USER=teleandes_user
MYSQL_PASSWORD=cambiar_esta_clave

APP_ENV=development
APP_PORT=8000
WEB_PORT=8080
LOG_LEVEL=INFO
